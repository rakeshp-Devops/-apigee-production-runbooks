## Script

**Path:** `/opt/apigee/scripts/zk_health_check.sh`  
**Owner:** `apigee:apigee`  
**Permissions:** `750`

```bash
#!/bin/bash

LOG=/var/log/zk_health.log
TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S')
ZK_NODES=("ZK-NODE-1-IP" "ZK-NODE-2-IP" "ZK-NODE-3-IP")
ZK_PORT=2181
LATENCY_WARN=500

log() { echo "[$TIMESTAMP] $1" >> "$LOG"; }

log "===== ZK Health Check Start ====="

LEADER_COUNT=0
FOLLOWER_COUNT=0

for NODE in "${ZK_NODES[@]}"; do
  log "--- Checking node: $NODE ---"

  RUOK=$(echo ruok | nc -w 3 "$NODE" "$ZK_PORT" 2>/dev/null)
  if [ "$RUOK" != "imok" ]; then
    log "CRITICAL: Node $NODE ruok FAILED - node may be DOWN"
    continue
  fi
  log "Node $NODE: ruok=imok OK"

  SRVR=$(echo srvr | nc -w 3 "$NODE" "$ZK_PORT" 2>/dev/null)
  MODE=$(echo "$SRVR" | grep "Mode:" | awk '{print $2}')
  log "Node $NODE: mode=$MODE"
  [ "$MODE" = "leader" ]   && LEADER_COUNT=$((LEADER_COUNT+1))
  [ "$MODE" = "follower" ] && FOLLOWER_COUNT=$((FOLLOWER_COUNT+1))
  [ -z "$MODE" ] && log "WARNING: Node $NODE mode unknown"

  MNTR=$(echo mntr | nc -w 3 "$NODE" "$ZK_PORT" 2>/dev/null)
  AVG_LAT=$(echo "$MNTR" | grep "zk_avg_latency"           | awk '{print $2}')
  OUT_REQ=$(echo "$MNTR" | grep "zk_outstanding_requests"  | awk '{print $2}')
  CONNS=$(echo   "$MNTR" | grep "zk_num_alive_connections" | awk '{print $2}')
  PSYNCS=$(echo  "$MNTR" | grep "zk_pending_syncs"         | awk '{print $2}')
  EPH=$(echo     "$MNTR" | grep "zk_ephemerals_count"      | awk '{print $2}')
  WATCHES=$(echo "$MNTR" | grep "zk_watch_count"           | awk '{print $2}')

  log "Node $NODE: avg_latency=${AVG_LAT}ms"
  log "Node $NODE: outstanding_requests=$OUT_REQ"
  log "Node $NODE: alive_connections=$CONNS"
  log "Node $NODE: pending_syncs=$PSYNCS"
  log "Node $NODE: ephemerals=$EPH"
  log "Node $NODE: watch_count=$WATCHES"

  if [ -n "$AVG_LAT" ] && [ "$AVG_LAT" -gt "$LATENCY_WARN" ] 2>/dev/null; then
    log "WARNING: Node $NODE high latency ${AVG_LAT}ms > threshold ${LATENCY_WARN}ms"
  fi
  if [ -n "$OUT_REQ" ] && [ "$OUT_REQ" -gt 10 ] 2>/dev/null; then
    log "WARNING: Node $NODE outstanding_requests=$OUT_REQ (>10)"
  fi

done

TOTAL_REACHABLE=$((LEADER_COUNT + FOLLOWER_COUNT))
log "Quorum: leaders=$LEADER_COUNT followers=$FOLLOWER_COUNT reachable=$TOTAL_REACHABLE/3"
[ "$TOTAL_REACHABLE" -lt 2 ] && \
  log "CRITICAL: Quorum LOST - only $TOTAL_REACHABLE/3 nodes reachable"
[ "$LEADER_COUNT" -ne 1 ] && [ "$TOTAL_REACHABLE" -ge 2 ] && \
  log "CRITICAL: Leader anomaly - $LEADER_COUNT leaders detected, expected 1"

log "===== ZK Health Check Complete ====="
```


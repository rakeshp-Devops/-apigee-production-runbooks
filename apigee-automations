## Verification Commands

```bash
# Check latest log output
tail -40 /var/log/zk_health.log

# Confirm cron is active
crontab -l

# Manual health check
bash /opt/apigee/scripts/zk_health_check.sh

# Quick ZK status from any node
echo ruok | nc -w 3 <ZK-NODE-1-IP> 2181
echo ruok | nc -w 3 <ZK-NODE-2-IP> 2181
echo ruok | nc -w 3 <ZK-NODE-3-IP> 2181

# Check leader
for ip in <ZK-NODE-1-IP> <ZK-NODE-2-IP> <ZK-NODE-3-IP>; do
  echo -n "$ip: "; echo srvr | nc -w 3 $ip 2181 | grep Mode
done
```

